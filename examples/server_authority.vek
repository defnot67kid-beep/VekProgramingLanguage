# VEK 1.9 server-authoritative gameplay policy example.
fn setup() {
    authority_action_register({
        id: "inventory.move_item",
        server_authoritative: true,
        allow_client_request: true,
        require_sequence: true,
        replay_protected: true,
        max_requests_per_second: 12,
        burst: 18,
        max_payload_bytes: 4096,
        required_capability: "inventory.use"
    });

    replication_schema_register({
        id: "player.public",
        max_hz: 30,
        reliable: false,
        fields: [
            {name:"position", type:"vec3", server_owned:true, owner_only:false},
            {name:"yaw", type:"number", server_owned:true, owner_only:false},
            {name:"health", type:"number", server_owned:true, owner_only:false}
        ]
    });
    return true;
}
